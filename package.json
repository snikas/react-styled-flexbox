{
  "name": "react-styled-flexbox",
  "version": "3.0.0",
  "description": "A Flexbox React component configured with simple boolean props",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "build:demo": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:dist": "node scripts/check-dist.mjs",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snikas/react-styled-flexbox.git"
  },
  "keywords": [
    "react",
    "reactjs",
    "react-component",
    "flex",
    "flexbox"
  ],
  "author": {
    "name": "Steven Akins"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/snikas/react-styled-flexbox/issues"
  },
  "homepage": "https://github.com/snikas/react-styled-flexbox#readme",
  "peerDependencies": {
    "react": ">=16.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
